	measure 'ERP Actual Historical' =
			
			VAR LastActualDate =
			    [ERP Siste Rapporterte Dato]
			VAR CurrentDate =
			    MAX ( dim_date[date] )
			RETURN
			    IF (
			        CurrentDate <= LastActualDate,
			        [ERP Regnskap],
			        BLANK ()
			    )
		displayFolder: 08 Forecast & Prediction\Series
		lineageTag: 7bc0e966-3cb5-489f-a8cc-1b4bc2f65b09

