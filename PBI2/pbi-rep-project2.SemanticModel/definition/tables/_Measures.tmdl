	measure 'ERP Regnskap Running' =
			VAR MaxDate = MAX ( dim_date[date] )
			RETURN CALCULATE ( [ERP Regnskap], FILTER ( ALLSELECTED ( dim_date[date] ), dim_date[date] <= MaxDate ) )
		formatString: #,##0.00
		displayFolder: 04 Time Intelligence\Running
		lineageTag: a705dac3-bbda-4325-b58c-1eaa13c98eb9

	measure 'ERP Budsjett Running' =
			VAR MaxDate = MAX ( dim_date[date] )
			RETURN CALCULATE ( [ERP Budsjett], FILTER ( ALLSELECTED ( dim_date[date] ), dim_date[date] <= MaxDate ) )
		formatString: #,##0.00
		displayFolder: 04 Time Intelligence\Running
		lineageTag: e4a7c703-139f-4b1d-aaf1-01c0dd997ea5

	measure 'ERP Regnskap Moving Avg 3M' =
			VAR EndDate = MAX ( dim_date[date] )
			VAR PeriodDates = DATESINPERIOD ( dim_date[date], EndDate, -3, MONTH )
			RETURN DIVIDE ( CALCULATE ( [ERP Regnskap], PeriodDates ), CALCULATE ( DISTINCTCOUNT ( dim_date[year_month] ), PeriodDates ) )
		formatString: #,##0.00
		displayFolder: 04 Time Intelligence\Rolling
		lineageTag: 23aa9439-14d2-4383-a73c-f986a6d8aadf

