	measure 'Corr Regnskap vs Budsjett' =
			
			VAR T =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_date[year_month] ),
			            "@Regnskap", CALCULATE ( [ERP Regnskap] ),
			            "@Budsjett", CALCULATE ( [ERP Budsjett] )
			        ),
			        NOT ISBLANK ( [@Regnskap] )
			            && NOT ISBLANK ( [@Budsjett] )
			    )
			
			VAR AvgX =
			    AVERAGEX ( T, [@Budsjett] )
			
			VAR AvgY =
			    AVERAGEX ( T, [@Regnskap] )
			
			VAR Numerator =
			    SUMX (
			        T,
			        ( [@Budsjett] - AvgX )
			            * ( [@Regnskap] - AvgY )
			    )
			
			VAR Denominator =
			    SQRT (
			        SUMX (
			            T,
			            POWER ( [@Budsjett] - AvgX, 2 )
			        )
			        *
			        SUMX (
			            T,
			            POWER ( [@Regnskap] - AvgY, 2 )
			        )
			    )
			
			RETURN
			    DIVIDE (
			        Numerator,
			        Denominator
			    )
		displayFolder: 11 Correlation\Measures
		lineageTag: 5fe56d73-1156-47f3-a765-cfd53d1f58e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Corr Regnskap vs Avvik' =
			
			VAR T =
			    FILTER (
			        ADDCOLUMNS (
			            VALUES ( dim_date[year_month] ),
			            "@Regnskap", CALCULATE ( [ERP Regnskap] ),
			            "@Avvik", CALCULATE ( [ERP Avvik] )
			        ),
			        NOT ISBLANK ( [@Regnskap] )
			            && NOT ISBLANK ( [@Avvik] )
			    )
			
			VAR AvgX =
			    AVERAGEX ( T, [@Regnskap] )
			
			VAR AvgY =
			    AVERAGEX ( T, [@Avvik] )
			
			VAR Numerator =
			    SUMX (
			        T,
			        ( [@Regnskap] - AvgX )
			            * ( [@Avvik] - AvgY )
			    )
			
			VAR Denominator =
			    SQRT (
			        SUMX (
			            T,
			            POWER ( [@Regnskap] - AvgX, 2 )
			        )
			        *
			        SUMX (
			            T,
			            POWER ( [@Avvik] - AvgY, 2 )
			        )
			    )
			
			RETURN
			    DIVIDE (
			        Numerator,
			        Denominator
			    )
		displayFolder: 11 Correlation\Measures
		lineageTag: 1e8ee74a-90f4-49fa-b721-c91964722954

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Correlation Strength' =
			
			VAR R =
			    [Corr Regnskap vs Budsjett]
			
			VAR AbsR =
			    ABS ( R )
			
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( R ), "Ingen data",
			        AbsR >= 0.80, "Svært sterk",
			        AbsR >= 0.60, "Sterk",
			        AbsR >= 0.40, "Moderat",
			        AbsR >= 0.20, "Svak",
			        "Svært svak"
			    )
		displayFolder: 11 Correlation\Interpretation
		lineageTag: 0c3253a8-2fb4-4d68-a413-44c847a65ec4

	measure 'Correlation Direction' =
			
			VAR R =
			    [Corr Regnskap vs Budsjett]
			
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( R ), "Ingen data",
			        R > 0, "Positiv",
			        R < 0, "Negativ",
			        "Ingen"
			    )
		displayFolder: 11 Correlation\Interpretation
		lineageTag: d2c217fc-4244-460a-9ace-163a92795098

