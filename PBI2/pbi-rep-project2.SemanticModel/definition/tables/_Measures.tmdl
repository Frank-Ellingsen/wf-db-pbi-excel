	measure 'ERP Rapportert Måned Nr' =
			VAR DatesWithActuals = CALCULATETABLE ( VALUES ( fact_erp_finance[date] ), fact_erp_finance[actual] <> 0 )
			VAR MaxActualDate = MAXX ( DatesWithActuals, fact_erp_finance[date] )
			RETURN IF ( ISBLANK ( MaxActualDate ), 12, MONTH ( MaxActualDate ) )
		formatString: 0
		displayFolder: 08 Forecast & Prediction\Base
		lineageTag: adbb60b9-e8e2-4f23-8f28-aff8bdff7ef8

	measure 'ERP EOY Run Rate' =
			VAR MonthNo = [ERP Rapportert Måned Nr]
			VAR ActualYTD = [ERP Regnskap YTD]
			RETURN IF ( MonthNo > 0, DIVIDE ( ActualYTD, MonthNo ) * 12 )
		formatString: #,##0.00
		displayFolder: 08 Forecast & Prediction\Base
		lineageTag: 0fb813ad-bf81-4b5c-81e2-df5ad812a93c

	measure 'EOY Årsbudsjett' =
			VAR FramsiktBudget = [Framsikt Årsbudsjett]
			VAR ERPAnnualBudget = CALCULATE ( [ERP Budsjett], REMOVEFILTERS ( dim_date ) )
			RETURN IF ( NOT ISBLANK ( FramsiktBudget ) && FramsiktBudget > 0, FramsiktBudget, ERPAnnualBudget )
		formatString: #,##0.00
		displayFolder: 08 Forecast & Prediction\Base
		lineageTag: 7aaad398-ee19-4f40-9693-6fa95b90bd2c

	measure 'EOY Run Rate Avvik' = [EOY Årsbudsjett] - [ERP EOY Run Rate]
		formatString: #,##0.00;-#,##0.00
		displayFolder: 08 Forecast & Prediction\EOY
		lineageTag: bfea1f5a-d79b-4b85-b5a2-f8c7ee76bae5

	measure 'EOY Run Rate Avvik %' = DIVIDE ( [EOY Run Rate Avvik], ABS ( [EOY Årsbudsjett] ) )
