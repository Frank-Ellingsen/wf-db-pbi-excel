		lineageTag: 94ef49a5-33f0-42de-bb5d-d62a3bc1f12e

	measure 'ERP Budget YTD To Latest' =
			VAR LastActualDate = [ERP Siste Rapporterte Dato]
			VAR SelectedYear = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    CALCULATE (
			        [ERP Budsjett],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = SelectedYear,
			        dim_date[date] <= LastActualDate
			    )
		formatString: #,##0.00;-#,##0.00
		displayFolder: 08 Forecast & Prediction\Base
		lineageTag: d93f76de-4336-4ef3-9d8d-f8bce67e6adf

	measure 'ERP Årsbudsjett' =
			VAR SelectedYear = SELECTEDVALUE ( dim_date[year] )
			RETURN
			    CALCULATE (
			        [ERP Budsjett],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = SelectedYear
			    )
		formatString: #,##0.00;-#,##0.00
		displayFolder: 08 Forecast & Prediction\Base
		lineageTag: 7abf0776-8383-449b-8a96-c9acce2a57f5

	measure 'ERP Måneder Igjen' =
			VAR LastActualDate = [ERP Siste Rapporterte Dato]
			RETURN
			    IF (
			        ISBLANK ( LastActualDate ),
			        BLANK (),
			        MAX ( 0, 12 - MONTH ( LastActualDate ) )
			    )
		formatString: 0
		displayFolder: 09 Balance & Action\Current
		lineageTag: 61985ddc-b0b5-4402-afcf-918d6d41bd4d

	measure 'ERP Resterende Ramme' = [ERP Årsbudsjett] - [ERP Actual YTD To Latest]
		formatString: #,##0.00;-#,##0.00
		displayFolder: 09 Balance & Action\Current
		lineageTag: 6136ddd7-9f45-4917-936e-4785907cf715

	measure 'ERP Forecast EOY Avvik' = [ERP Årsbudsjett] - [ERP Forecast EOY]
		formatString: #,##0.00;-#,##0.00
		displayFolder: 08 Forecast & Prediction\EOY
		lineageTag: 076b8fa1-7ce5-4b73-95d4-ee70765aa996

	measure 'ERP Forecast EOY Avvik %' = DIVIDE ( [ERP Forecast EOY Avvik], ABS ( [ERP Årsbudsjett] ) )
		formatString: 0.0%;-0.0%
		displayFolder: 08 Forecast & Prediction\EOY
		lineageTag: 2c86709f-7618-43a6-9d22-c2f74b556c36

	measure 'ERP Total Tiltaksbehov' = [ERP Månedlig Tiltaksbehov] * [ERP Måneder Igjen]
		formatString: #,##0.00
		displayFolder: 09 Balance & Action\Current
		lineageTag: 5fa99d8a-aaa6-48ff-ab66-8582c3529c4e

	measure 'ERP Negativ Kostnadsdriver' =
			VAR V = [ERP Avvik YTD]
			RETURN IF ( V < 0, ABS ( V ), BLANK () )
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Base
		lineageTag: 5a32a87f-0e52-4e14-a465-6b998b6044c4

	measure 'ERP Total Negativ Kostnadsdriver' =
			SUMX (
			    ALLSELECTED ( dim_account[account_name] ),
			    CALCULATE ( [ERP Negativ Kostnadsdriver] )
			)
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Base
		lineageTag: 1c076b86-a6e8-46a2-81e6-7b2d0ea5de8e

	measure 'ERP Negativ Driver Rank' =
			RANKX (
			    FILTER (
			        ALLSELECTED ( dim_account[account_name] ),
			        CALCULATE ( [ERP Negativ Kostnadsdriver] ) > 0
			    ),
			    CALCULATE ( [ERP Negativ Kostnadsdriver] ),
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 10 Cost Drivers\Ranking
		lineageTag: c324316b-3e88-4d28-b2df-d10e551e7796

	measure 'ERP Negativ Driver Andel %' = DIVIDE ( [ERP Negativ Kostnadsdriver], [ERP Total Negativ Kostnadsdriver] )
		formatString: 0.0%
		displayFolder: 10 Cost Drivers\Contribution
		lineageTag: 165eaee6-83ea-4502-8e1b-35b9f7a8f4c0

	measure 'ERP Pareto Kumulativ Driver' =
			VAR CurrentRank = [ERP Negativ Driver Rank]
			VAR DriverTable =
			    ADDCOLUMNS (
			        ALLSELECTED ( dim_account[account_name] ),
			        "@Rank", CALCULATE ( [ERP Negativ Driver Rank] ),
			        "@Driver", CALCULATE ( [ERP Negativ Kostnadsdriver] )
			    )
			RETURN
			    SUMX (
			        FILTER ( DriverTable, [@Rank] <= CurrentRank && NOT ISBLANK ( [@Driver] ) ),
			        [@Driver]
			    )
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Pareto
		lineageTag: 317b8cc8-0bb5-4d9d-a6e5-ee180cad54f5

	measure 'ERP Pareto Kumulativ %' = DIVIDE ( [ERP Pareto Kumulativ Driver], [ERP Total Negativ Kostnadsdriver] )
		formatString: 0.0%
		displayFolder: 10 Cost Drivers\Pareto
		lineageTag: 53ee3b1c-9c4f-49dd-a18a-852f7be26ece

	measure 'ERP Pareto 80 %' = 0.8
		formatString: 0%
		displayFolder: 10 Cost Drivers\Pareto
		lineageTag: 6c96649e-c65e-4f92-a6b7-13e26d3d2ad7

	measure 'ERP Driver Tiltaksbehov Måned' = [ERP Månedlig Tiltaksbehov] * [ERP Negativ Driver Andel %]
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Action
		lineageTag: 569486c5-937b-49c4-89df-93ae3067e9c8

	measure 'ERP Driver Tiltaksbehov Restår' = [ERP Driver Tiltaksbehov Måned] * [ERP Måneder Igjen]
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Action
		lineageTag: 73a905a8-cf61-4ee3-9bb0-3bc7ec219ae9

	measure 'ERP Driver Tiltaksgrad %' = DIVIDE ( [ERP Driver Tiltaksbehov Restår], [ERP Negativ Kostnadsdriver] )
		formatString: 0.0%
		displayFolder: 10 Cost Drivers\Action
		lineageTag: c35b8d1b-19c9-47d4-b099-6beb868bd263

	measure 'ERP Største Kostnadsdriver' =
			VAR TopAccount =
			    TOPN (
			        1,
			        FILTER ( ALLSELECTED ( dim_account[account_name] ), CALCULATE ( [ERP Avvik YTD] ) < 0 ),
			        [ERP Negativ Kostnadsdriver], DESC,
			        dim_account[account_name], ASC
			    )
			RETURN CONCATENATEX ( TopAccount, dim_account[account_name], ", " )
		displayFolder: 10 Cost Drivers\Top Driver
		lineageTag: 79806338-5245-45ad-8e8c-04260b2ac005

	measure 'ERP Største Kostnadsdriver Beløp' =
			MAXX (
			    FILTER ( ALLSELECTED ( dim_account[account_name] ), CALCULATE ( [ERP Avvik YTD] ) < 0 ),
			    [ERP Negativ Kostnadsdriver]
			)
		formatString: #,##0.00
		displayFolder: 10 Cost Drivers\Top Driver
		lineageTag: 02529a49-b539-4bc0-ad97-4c095dde60ab

	measure 'Selected Forecast Context' =
			VAR YearTxt =
			    IF (
			        ISFILTERED ( dim_date[year] ),
			        CONCATENATEX ( VALUES ( dim_date[year] ), dim_date[year], ", ", dim_date[year], ASC ),
			        "Alle år"
			    )
			VAR OrganizationTxt =
			    IF (
			        ISFILTERED ( dim_budget_organization[budget_level_2_name] ),
			        CONCATENATEX (
			            VALUES ( dim_budget_organization[budget_level_2_name] ),
			            dim_budget_organization[budget_level_2_name],
			            ", ",
			            dim_budget_organization[budget_level_2_name],
			            ASC
			        ),
			        "Alle budsjettområder"
			    )
			RETURN "Viser: " & YearTxt & " | " & OrganizationTxt
		displayFolder: 15 Selection Context
		lineageTag: e78a4372-248a-4b30-8df7-050f6482ed81

	measure 'ERP Forecast EOY RAG' =
			VAR Gap = [ERP Forecast EOY Avvik]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( Gap ), "NO_DATA", Gap > 0, "GREEN", Gap < 0, "RED", "YELLOW" )
		displayFolder: 13 RAG\Forecast
		lineageTag: f666e001-d8e3-44d6-b3ad-292d16a4f490

	measure 'ERP Forecast EOY Color' = SWITCH ( [ERP Forecast EOY RAG], "GREEN", "#107C10", "YELLOW", "#FFB900", "RED", "#D13438", "#A19F9D" )
		displayFolder: 14 Conditional Formatting\Colors
		lineageTag: fa61953d-fa7d-431b-abe5-53378a808010

	measure 'Forecast Action Summary' =
			VAR Gap = [ERP Forecast EOY Avvik]
			VAR MonthlyAction = [ERP Månedlig Tiltaksbehov]
			VAR MonthlyActionPct = [ERP Månedlig Tiltaksbehov %]
			VAR RemainingMonths = [ERP Måneder Igjen]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Gap ), "Ingen prognose tilgjengelig.",
			        Gap >= 0, "Prognosen indikerer balanse eller mindreforbruk ved årets slutt. Ingen generell kostnadsreduksjon er nødvendig basert på dagens prognose.",
			        "Prognosen indikerer merforbruk ved årets slutt. For å nå budsjettbalanse må forventet månedlig kostnadsnivå reduseres med "
			            & FORMAT ( MonthlyAction, "#,##0 kr" )
			            & " per måned i de resterende " & FORMAT ( RemainingMonths, "0" )
			            & " månedene, tilsvarende " & FORMAT ( MonthlyActionPct, "0.0%" ) & "."
			    )
		displayFolder: 17 Storytelling Commentary\Forecast
		lineageTag: 5990ce6d-b235-4716-b21c-e73e837d722b

	measure 'ERP RAG Background' = SWITCH ( [ERP RAG], "GREEN", "#E6F4EA", "YELLOW", "#FEF3C7", "RED", "#FEE2E2", "#F1F5F9" )
		displayFolder: 14 Conditional Formatting\Colors
		lineageTag: 557cb232-b37e-46d9-b333-65585075494b

	measure 'ERP RAG Font Color' = SWITCH ( [ERP RAG], "GREEN", "#166534", "YELLOW", "#92400E", "RED", "#991B1B", "#334155" )
		displayFolder: 14 Conditional Formatting\Colors
		lineageTag: 4393277a-ac21-4636-84dc-ccc0466dc447

	measure 'ERP Forecast EOY Background' = SWITCH ( [ERP Forecast EOY RAG], "GREEN", "#E6F4EA", "YELLOW", "#FEF3C7", "RED", "#FEE2E2", "#F1F5F9" )
		displayFolder: 14 Conditional Formatting\Colors
		lineageTag: 7c830128-3d53-4992-b565-14e345a53e37

	measure 'ERP Bar Positiv' = IF ( [ERP Avvik] > 0, [ERP Avvik], BLANK () )
		formatString: #,##0.00
		displayFolder: 14 Conditional Formatting\Bars
