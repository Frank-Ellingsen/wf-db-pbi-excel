	measure 'ERP S-Kurve Budsjett Label' = IF ( MAX ( dim_date[month_number] ) = 12, "Budsjett: " & FORMAT ( [ERP Budsjett Running], "#,##0 MNOK" ), BLANK () )
		displayFolder: 16 Titles & Labels
