	measure 'ERP Forecast EOY' =
			
			VAR LastActualDate =
			    [ERP Siste Rapporterte Dato]
			VAR LastActualMonth =
			    MONTH ( LastActualDate )
			VAR ActualYTD =
			    CALCULATE (
			        [ERP Regnskap],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[date] <= LastActualDate,
			        YEAR ( dim_date[date] ) = YEAR ( LastActualDate )
			    )
			VAR RemainingMonths =
			    12 - LastActualMonth
			RETURN
			    ActualYTD
			        + RemainingMonths * [ERP Forecast Monthly Rate]
		displayFolder: 08 Forecast & Prediction\EOY
		lineageTag: 3f41acff-1e45-456c-a21d-43b80117fac3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERP Forecast Trend' =
			
			VAR LastActualDate =
			    [ERP Siste Rapporterte Dato]
			
			VAR LastActualMonth =
			    MONTH ( LastActualDate )
			
			VAR CurrentMonth =
			    MAX ( dim_date[month_number] )
			
			VAR SelectedYear =
			    SELECTEDVALUE ( dim_date[year] )
			
			VAR HistoricalMonths =
			    FILTER (
			        ALL ( dim_date[month_number] ),
			        dim_date[month_number] <= LastActualMonth
			    )
			
			VAR RegressionTable =
			    ADDCOLUMNS (
			        HistoricalMonths,
			        "@Actual",
			            CALCULATE (
			                [ERP Regnskap],
			                REMOVEFILTERS ( dim_date ),
			                dim_date[year] = SelectedYear
			            )
			    )
			
			VAR ValidHistory =
			    FILTER (
			        RegressionTable,
			        NOT ISBLANK ( [@Actual] )
			    )
			
			VAR Regression =
			    LINESTX (
			        ValidHistory,
			        [@Actual],
			        dim_date[month_number]
			    )
			
			VAR Slope =
			    MAXX ( Regression, [Slope1] )
			
			VAR Intercept =
			    MAXX ( Regression, [Intercept] )
			
			VAR ForecastValue =
			    Intercept
			        + Slope * CurrentMonth
			
			RETURN
			    IF (
			        CurrentMonth > LastActualMonth,
			        ForecastValue,
			        BLANK ()
			    )
		displayFolder: 08 Forecast & Prediction\Series
		lineageTag: e53c6c73-576e-4649-a0d7-58ee46a74f0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERP Akkumulert Avvik YTD' =
			
			VAR LastActualDate =
			    [ERP Siste Rapporterte Dato]
			VAR SelectedYear =
			    SELECTEDVALUE ( dim_date[year] )
			RETURN
			    CALCULATE (
			        [ERP Budsjett] - [ERP Regnskap],
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = SelectedYear,
			        dim_date[date] <= LastActualDate
			    )
		displayFolder: 09 Balance & Action\Current
		lineageTag: c131b2ce-e31f-4e87-b024-5d9523783ab6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERP Tillatt Regnskap Resten Av Året' =
			
			VAR AnnualBudget =
			    CALCULATE (
			        [ERP Budsjett],
			        REMOVEFILTERS ( dim_date[year_month] )
			    )
			
			VAR ActualYTD =
			    VAR LastActualDate =
			        [ERP Siste Rapporterte Dato]
			    VAR SelectedYear =
			        SELECTEDVALUE ( dim_date[year] )
			    RETURN
			        CALCULATE (
			            [ERP Regnskap],
			            REMOVEFILTERS ( dim_date ),
			            dim_date[year] = SelectedYear,
			            dim_date[date] <= LastActualDate
			        )
			
			RETURN
			    AnnualBudget - ActualYTD
		displayFolder: 09 Balance & Action\Current
		lineageTag: 3da7b827-45ed-45a5-a5a2-89961dd9cad8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERP Nødvendig Månedlig Nivå' =
			
			VAR LastActualDate =
			    [ERP Siste Rapporterte Dato]
			
			VAR RemainingMonths =
			    12 - MONTH ( LastActualDate )
			
			VAR RemainingCapacity =
			    [ERP Tillatt Regnskap Resten Av Året]
			
			RETURN
			    IF (
			        RemainingMonths > 0,
			        DIVIDE (
			            RemainingCapacity,
			            RemainingMonths
			        )
			    )
		displayFolder: 09 Balance & Action\Current
		lineageTag: 21a92f0c-1bfb-4e71-9627-e3286180381a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'ERP Månedlig Tiltaksbehov' =
			
			VAR CurrentRunRate =
			    [ERP Forecast Monthly Rate]
			
			VAR RequiredMonthlyLevel =
