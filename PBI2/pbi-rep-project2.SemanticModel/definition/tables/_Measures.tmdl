	measure 'ERP S-Kurve EAC Label' = IF ( MAX ( dim_date[month_number] ) = 12, "EAC Prognose: " & FORMAT ( [ERP Forecast EOY], "#,##0 MNOK" ), BLANK () )
		displayFolder: 16 Titles & Labels
		lineageTag: d04de75d-a83f-49fb-ae74-74b0c0949c75

	measure 'Selected Account Drillthrough Title' = "Kontodybde: " & SELECTEDVALUE ( dim_account[account_code], "Konto" ) & " " & SELECTEDVALUE ( dim_account[account_name], "Alle konti" )
		displayFolder: 16 Titles & Labels
