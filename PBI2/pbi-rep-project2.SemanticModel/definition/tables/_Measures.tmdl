	measure 'ERP S-Kurve Regnskap Label' = IF ( MAX ( dim_date[month_number] ) = MONTH ( [ERP Siste Rapporterte Dato] ), "Faktisk YTD: " & FORMAT ( [ERP Regnskap Running], "#,##0 MNOK" ), BLANK () )
		displayFolder: 16 Titles & Labels
